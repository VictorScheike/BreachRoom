{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "breachroom",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "breachroom.victorscheike.com",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
